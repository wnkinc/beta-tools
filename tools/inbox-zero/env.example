# inbox-zero: copy to .env (gitignored). Compose sets the URLs, db/redis wiring,
# MCP flags and the LLM choice; this file holds only secrets + Google identity.

# --- Random secrets (openssl rand -hex 32; the salt: -hex 16) ---
AUTH_SECRET=
INTERNAL_API_KEY=
EMAIL_ENCRYPT_SECRET=
EMAIL_ENCRYPT_SALT=
CRON_SECRET=
API_KEY_SALT=
# Same value twice: the app's client token and the redis-http proxy's.
REDIS_HTTP_TOKEN=
SRH_TOKEN=

# --- Google (the stack's shared OAuth client; add inbox-zero's redirect URIs) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# projects/<project-id>/topics/<topic>
GOOGLE_PUBSUB_TOPIC_NAME=
# The ?token= value in the push subscription's endpoint URL.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# --- Claude subscription for the rules engine (`claude setup-token`) ---
CLAUDE_CODE_OAUTH_TOKEN=
